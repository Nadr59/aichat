{
"manifest_version": 2,
"name": "AiChat Web Extension",
"version": "1.0.19",
"description": "AiChat GeckoView WebExtension",

"permissions": [
"nativeMessaging",
"tabs",
"<all_urls>"
],

"background": {
"scripts": [
"background.js"
]
},

"content_scripts": [
{
"matches": [
"<all_urls>"
],
"js": [
"content.js"
],
"run_at": "document_idle"
}
],

"browser_specific_settings": {
"gecko": {
"id": "aichat@local"
}
}
}
