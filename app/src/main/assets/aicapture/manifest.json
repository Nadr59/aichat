{
  "manifest_version": 2,
  "name": "AiChat Capture",
  "version": "1.0.6",
  "browser_specific_settings": {
    "gecko": {
      "id": "aicapture@aichat.example.com"
    }
  },
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons",
    "tabs",
    "activeTab",
    "*://chatgpt.com/*",
    "*://*.openai.com/*",
    "*://claude.ai/*",
    "*://gemini.google.com/*",
    "*://perplexity.ai/*",
    "*://copilot.microsoft.com/*",
    "*://grok.com/*",
    "*://chat.mistral.ai/*",
    "*://you.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [{
    "matches": [
      "*://chatgpt.com/*",
      "*://*.openai.com/*",
      "*://claude.ai/*",
      "*://gemini.google.com/*",
      "*://perplexity.ai/*",
      "*://copilot.microsoft.com/*",
      "*://grok.com/*",
      "*://chat.mistral.ai/*",
      "*://you.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
