{
  "manifest_version": 2,
  "name": "AiChat Capture",
  "version": "1.0",
  "description": "Captures AI responses for memory",

  "browser_specific_settings": {
    "gecko_android": {
      "id": "aicapture@aichat.example.com"
    }
  },

  "content_scripts": [{
    "matches": [
      "*://chatgpt.com/*",
      "*://*.openai.com/*",
      "*://claude.ai/*",
      "*://gemini.google.com/*",
      "*://perplexity.ai/*",
      "*://copilot.microsoft.com/*",
      "*://grok.com/*",
      "*://chat.mistral.ai/*",
      "*://you.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],

  "permissions": [
    "nativeMessaging"
  ]
}
